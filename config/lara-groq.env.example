# Server-side only. Never upload a real .env or an API key.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Set true only after confirming the Groq organization is on Free Tier with no paid billing.
LLM_GROQ_FREE_TIER_CONFIRMED=false
# Set true only for authorized public/sanitized communication. Never send confidential records.
LLM_EXTERNAL_DATA_APPROVED=false
LLM_FALLBACK_PROVIDER=none
LLM_MAX_CONCURRENT=1
LLM_TIMEOUT=20000
LLM_MAX_TOKENS=700
LLM_CONTEXT_BYTES=12000
