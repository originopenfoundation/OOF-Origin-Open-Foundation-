HOST=127.0.0.1
PORT=4173
NODE_ENV=development
LARA_ADMIN_TOKEN=
LARA_SESSION_TTL_MINUTES=60
LARA_RATE_LIMIT_PER_MINUTE=20
LARA_TRUST_PROXY=false
LARA_CHAT_CONCURRENCY=4
LARA_REQUEST_TIMEOUT_MS=15000
LARA_LOG_LEVEL=info
LARA_LOG_QUERIES=false
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_TIMEOUT=20000
LLM_MAX_TOKENS=700
LLM_CONTEXT_BYTES=22000
LLM_MAX_CONCURRENT=2
# Fallback is opt-in; explicitly supply its model, server key and endpoint.
# It never silently reuses a different provider's credentials.
LARA_MAX_REQUEST_BYTES=12000
# Knowledge is consumed read-only from data/knowledge; no separate LaRA index.

# LaRA Personality Layer v1.0 (restart after changing)
LARA_PERSONALITY_ENABLED=true
LARA_PERSONALITY_MODE=natural
LARA_PERSONALITY_HUMOR=balanced

# Exact frontend origins allowed to call the Render API
LARA_ALLOWED_ORIGINS=https://originopenfoundation.org,https://www.originopenfoundation.org
